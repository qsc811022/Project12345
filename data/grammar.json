[
  {
    "id": "eun-neun",
    "titleKo": "은/는",
    "meaningZh": "主題、對比",
    "category": "助詞",
    "attachRule": "名詞有收音接 은；無收音接 는。",
    "explanation": "用來提出談論的主題，也可用來對比不同對象。",
    "examples": [
      {
        "ko": "저는 학생이에요.",
        "zh": "我是學生。"
      },
      {
        "ko": "오늘은 바빠요.",
        "zh": "今天很忙。"
      }
    ],
    "note": "은/는 與 이/가 的選擇也受上下文影響，不能只用中文「是」來判斷。"
  },
  {
    "id": "i-ga",
    "titleKo": "이/가",
    "meaningZh": "標示主詞",
    "category": "助詞",
    "attachRule": "名詞有收音接 이；無收音接 가。",
    "explanation": "常用於指出主詞或提供新的資訊；疑問詞作主詞時也常用。",
    "examples": [
      {
        "ko": "비가 와요.",
        "zh": "下雨了。"
      },
      {
        "ko": "책이 있어요.",
        "zh": "有書。"
      }
    ]
  },
  {
    "id": "eul-reul",
    "titleKo": "을/를",
    "meaningZh": "標示受詞",
    "category": "助詞",
    "attachRule": "名詞有收音接 을；無收音接 를。",
    "explanation": "標示動作的對象，常搭配吃、讀、買等動詞。",
    "examples": [
      {
        "ko": "밥을 먹어요.",
        "zh": "我吃飯。"
      },
      {
        "ko": "커피를 마셔요.",
        "zh": "我喝咖啡。"
      }
    ]
  },
  {
    "id": "e",
    "titleKo": "에",
    "meaningZh": "位置、目的地、時間點",
    "category": "助詞",
    "attachRule": "直接接在表示位置或時間的名詞後。",
    "explanation": "搭配 있다 表示所在位置，搭配 가다 表示目的地，也可表示時間點。",
    "examples": [
      {
        "ko": "집에 있어요.",
        "zh": "我在家。"
      },
      {
        "ko": "세 시에 만나요.",
        "zh": "我們三點見。"
      }
    ],
    "note": "活動發生的地點通常用 에서；오늘、내일 等時間詞通常不加 에。"
  },
  {
    "id": "eseo",
    "titleKo": "에서",
    "meaningZh": "動作地點、出發處",
    "category": "助詞",
    "attachRule": "直接接地點名詞。",
    "explanation": "表示動作發生的場所；搭配移動動詞時，也可表示從某地出發。",
    "examples": [
      {
        "ko": "도서관에서 공부해요.",
        "zh": "我在圖書館讀書。"
      },
      {
        "ko": "대만에서 왔어요.",
        "zh": "我來自台灣。"
      }
    ]
  },
  {
    "id": "do",
    "titleKo": "도",
    "meaningZh": "也",
    "category": "助詞",
    "attachRule": "直接接名詞；常取代 은/는、이/가、을/를。",
    "explanation": "將另一個人或事物加入相同的敘述中。",
    "examples": [
      {
        "ko": "저도 가요.",
        "zh": "我也去。"
      },
      {
        "ko": "물도 주세요.",
        "zh": "也請給我水。"
      }
    ]
  },
  {
    "id": "hago",
    "titleKo": "하고",
    "meaningZh": "和、跟",
    "category": "助詞",
    "attachRule": "直接接名詞。",
    "explanation": "用來並列名詞，也可表示與某人一起。",
    "examples": [
      {
        "ko": "빵하고 우유를 사요.",
        "zh": "我買麵包和牛奶。"
      },
      {
        "ko": "친구하고 가요.",
        "zh": "我和朋友一起去。"
      }
    ]
  },
  {
    "id": "wa-gwa",
    "titleKo": "와/과",
    "meaningZh": "和、與",
    "category": "助詞",
    "attachRule": "有收音接 과；無收音接 와。",
    "explanation": "連接名詞或表示共同參與者，常見於書面表達。",
    "examples": [
      {
        "ko": "책과 공책이 있어요.",
        "zh": "有書和筆記本。"
      },
      {
        "ko": "친구와 산책해요.",
        "zh": "我和朋友散步。"
      }
    ]
  },
  {
    "id": "euro",
    "titleKo": "(으)로",
    "meaningZh": "方向、工具、方法",
    "category": "助詞",
    "attachRule": "有收音接 으로；無收音或 ㄹ 收音接 로。",
    "explanation": "表示前往的方向、使用的工具或交通方式。",
    "examples": [
      {
        "ko": "버스로 가요.",
        "zh": "我搭公車去。"
      },
      {
        "ko": "오른쪽으로 가세요.",
        "zh": "請往右走。"
      }
    ],
    "note": "길 的收音是 ㄹ，因此使用 길로，而非 길으로。"
  },
  {
    "id": "buteo-kkaji",
    "titleKo": "부터/까지",
    "meaningZh": "從…到…",
    "category": "助詞",
    "attachRule": "分別接起點與終點名詞。",
    "explanation": "常表示時間範圍，也能搭配地點或順序。",
    "examples": [
      {
        "ko": "아홉 시부터 일해요.",
        "zh": "我從九點開始工作。"
      },
      {
        "ko": "다섯 시까지 공부해요.",
        "zh": "我讀書到五點。"
      }
    ]
  },
  {
    "id": "ege-hante",
    "titleKo": "에게/한테",
    "meaningZh": "給、向某人",
    "category": "助詞",
    "attachRule": "接人或動物名詞；한테 較口語。",
    "explanation": "標示給予、說話等動作的對象。",
    "examples": [
      {
        "ko": "친구에게 편지를 써요.",
        "zh": "我寫信給朋友。"
      },
      {
        "ko": "동생한테 선물을 줘요.",
        "zh": "我送禮物給弟弟／妹妹。"
      }
    ]
  },
  {
    "id": "kkeseo",
    "titleKo": "께서",
    "meaningZh": "主詞敬語助詞",
    "category": "助詞",
    "attachRule": "接需要尊敬的人物名詞。",
    "explanation": "以敬語標示主詞，後面的述語通常也使用敬語形式。",
    "examples": [
      {
        "ko": "선생님께서 오세요.",
        "zh": "老師來了。"
      },
      {
        "ko": "할머니께서 주무세요.",
        "zh": "奶奶在睡覺。"
      }
    ]
  },
  {
    "id": "an",
    "titleKo": "안",
    "meaningZh": "不、沒",
    "category": "否定",
    "attachRule": "通常放在動詞或形容詞前；名詞＋하다 類常放在名詞與 하다 之間。",
    "explanation": "簡短否定動作或狀態。",
    "examples": [
      {
        "ko": "오늘은 안 가요.",
        "zh": "今天不去。"
      },
      {
        "ko": "이 음식은 안 매워요.",
        "zh": "這道菜不辣。"
      }
    ],
    "note": "不是所有詞都用 안 否定，例如 있다 常以 없다 否定。"
  },
  {
    "id": "ji-anta",
    "titleKo": "-지 않다",
    "meaningZh": "不…",
    "category": "否定",
    "attachRule": "動詞或形容詞去掉 다，再接 -지 않다 並變化語尾。",
    "explanation": "完整的否定表達，可用於動作與性質。",
    "examples": [
      {
        "ko": "고기를 먹지 않아요.",
        "zh": "我不吃肉。"
      },
      {
        "ko": "오늘은 춥지 않아요.",
        "zh": "今天不冷。"
      }
    ]
  },
  {
    "id": "a-eoyo",
    "titleKo": "-아/어요",
    "meaningZh": "日常禮貌語尾",
    "category": "語尾與表達",
    "attachRule": "詞幹最後母音為 ㅏ、ㅗ 通常接 아요；其他接 어요；하다 → 해요。",
    "explanation": "在日常對話中禮貌地陳述或提問。",
    "examples": [
      {
        "ko": "학교에 가요.",
        "zh": "我去學校。"
      },
      {
        "ko": "책을 읽어요.",
        "zh": "我讀書。"
      }
    ],
    "note": "母音縮合與不規則變化需另外學習，例如 보다 → 봐요。"
  },
  {
    "id": "go-sipda",
    "titleKo": "-고 싶다",
    "meaningZh": "想要做…",
    "category": "語尾與表達",
    "attachRule": "動詞詞幹接 -고 싶다，禮貌形式為 -고 싶어요。",
    "explanation": "表達自己的願望，或詢問對方的願望。",
    "examples": [
      {
        "ko": "한국에 가고 싶어요.",
        "zh": "我想去韓國。"
      },
      {
        "ko": "뭐 먹고 싶어요?",
        "zh": "你想吃什麼？"
      }
    ],
    "note": "描述第三人的願望常使用 -고 싶어 하다。"
  },
  {
    "id": "euseyo",
    "titleKo": "-(으)세요",
    "meaningZh": "請…／敬語",
    "category": "語尾與表達",
    "attachRule": "詞幹有收音接 으세요；無收音接 세요；ㄹ 收音先去掉 ㄹ。",
    "explanation": "可表示禮貌請求，也可用來尊敬句子的主體。",
    "examples": [
      {
        "ko": "여기에 앉으세요.",
        "zh": "請坐這裡。"
      },
      {
        "ko": "천천히 가세요.",
        "zh": "請慢慢走。"
      }
    ]
  },
  {
    "id": "eul-geoyeyo",
    "titleKo": "-(으)ㄹ 거예요",
    "meaningZh": "將會、打算",
    "category": "語尾與表達",
    "attachRule": "有收音接 을 거예요；無收音接 ㄹ 거예요；ㄹ 收音接 거예요。",
    "explanation": "表達未來計畫，也能依情境表示推測。",
    "examples": [
      {
        "ko": "내일 공부할 거예요.",
        "zh": "我明天打算讀書。"
      },
      {
        "ko": "주말에 쉴 거예요.",
        "zh": "我週末要休息。"
      }
    ]
  },
  {
    "id": "jiman",
    "titleKo": "-지만",
    "meaningZh": "但是、雖然",
    "category": "語尾與表達",
    "attachRule": "動詞、形容詞詞幹接 -지만；名詞接 이지만。",
    "explanation": "連接兩個對比或轉折的內容。",
    "examples": [
      {
        "ko": "작지만 편해요.",
        "zh": "雖然小，但很舒適。"
      },
      {
        "ko": "비싸지만 맛있어요.",
        "zh": "雖然貴，但很好吃。"
      }
    ]
  },
  {
    "id": "eul-su",
    "titleKo": "-(으)ㄹ 수 있다/없다",
    "meaningZh": "能／不能",
    "category": "語尾與表達",
    "attachRule": "有收音接 을 수；無收音接 ㄹ 수；ㄹ 收音接 수，再加 있다 或 없다。",
    "explanation": "表示能力或某種情況下的可能性。",
    "examples": [
      {
        "ko": "한국어를 읽을 수 있어요.",
        "zh": "我能讀韓文。"
      },
      {
        "ko": "오늘은 갈 수 없어요.",
        "zh": "我今天不能去。"
      }
    ]
  },
  {
    "id": "ieyo-yeyo",
    "titleKo": "이에요/예요",
    "meaningZh": "是…",
    "category": "語尾與表達",
    "attachRule": "名詞有收音接 이에요；無收音接 예요。",
    "explanation": "日常禮貌地說明身分或事物。",
    "examples": [
      {
        "ko": "저는 학생이에요.",
        "zh": "我是學生。"
      },
      {
        "ko": "여기는 학교예요.",
        "zh": "這裡是學校。"
      }
    ]
  },
  {
    "id": "isseoyo",
    "titleKo": "있어요/없어요",
    "meaningZh": "有／沒有、在／不在",
    "category": "語尾與表達",
    "attachRule": "通常以名詞＋이/가 있다/없다 表示有無；位置接 에。",
    "explanation": "表達存在、位置或擁有。",
    "examples": [
      {
        "ko": "시간이 있어요.",
        "zh": "我有時間。"
      },
      {
        "ko": "집에 사람이 없어요.",
        "zh": "家裡沒有人。"
      }
    ]
  },
  {
    "id": "go",
    "titleKo": "-고",
    "meaningZh": "…並且…",
    "category": "語尾與表達",
    "attachRule": "動詞或形容詞詞幹接 -고。",
    "explanation": "連接並列的動作或性質；動作也可有先後關係。",
    "examples": [
      {
        "ko": "밥을 먹고 쉬어요.",
        "zh": "我吃飯後休息。"
      },
      {
        "ko": "방이 크고 깨끗해요.",
        "zh": "房間又大又乾淨。"
      }
    ]
  },
  {
    "id": "eseo-reason",
    "titleKo": "-아/어서",
    "meaningZh": "因為…／…之後",
    "category": "語尾與表達",
    "attachRule": "依詞幹母音接 아서 或 어서；하다 → 해서。",
    "explanation": "表示原因，或前後密切相連的動作；本頁先練習原因用法。",
    "examples": [
      {
        "ko": "비가 와서 집에 있어요.",
        "zh": "因為下雨，我待在家。"
      },
      {
        "ko": "늦어서 죄송합니다.",
        "zh": "很抱歉我遲到了。"
      }
    ],
    "note": "表示原因時，後句通常不接命令或提議。"
  },
  {
    "id": "eumyeon",
    "titleKo": "-(으)면",
    "meaningZh": "如果…／…的話",
    "category": "語尾與表達",
    "attachRule": "有收音接 으면；無收音或 ㄹ 收音接 면。",
    "explanation": "表示假設或條件。",
    "examples": [
      {
        "ko": "시간이 있으면 만나요.",
        "zh": "有時間的話就見面吧。"
      },
      {
        "ko": "비가 오면 집에 있을 거예요.",
        "zh": "如果下雨，我會待在家。"
      }
    ]
  },
  {
    "id": "eulkkayo",
    "titleKo": "-(으)ㄹ까요?",
    "meaningZh": "要不要…？／會…嗎？",
    "category": "語尾與表達",
    "attachRule": "有收音接 을까요；無收音接 ㄹ까요；ㄹ 收音接 까요。",
    "explanation": "提出建議或詢問對方的看法。",
    "examples": [
      {
        "ko": "같이 갈까요?",
        "zh": "要一起去嗎？"
      },
      {
        "ko": "뭘 먹을까요?",
        "zh": "我們吃什麼好呢？"
      }
    ]
  },
  {
    "id": "a-eo-juseyo",
    "titleKo": "-아/어 주세요",
    "meaningZh": "請幫忙…",
    "category": "語尾與表達",
    "attachRule": "動詞詞幹依母音接 아/어 주세요；하다 → 해 주세요。",
    "explanation": "請對方為自己或他人做某件事。",
    "examples": [
      {
        "ko": "문을 열어 주세요.",
        "zh": "請幫忙開門。"
      },
      {
        "ko": "다시 말해 주세요.",
        "zh": "請再說一次。"
      }
    ]
  },
  {
    "id": "past",
    "titleKo": "-았/었어요",
    "meaningZh": "過去式",
    "category": "語尾與表達",
    "attachRule": "詞幹末母音為 ㅏ、ㅗ 通常接 았어요；其他接 었어요；하다 → 했어요。",
    "explanation": "禮貌地描述已發生的事情。",
    "examples": [
      {
        "ko": "어제 영화를 봤어요.",
        "zh": "我昨天看了電影。"
      },
      {
        "ko": "아침을 먹었어요.",
        "zh": "我吃過早餐了。"
      }
    ]
  },
  {
    "id": "go-itda",
    "titleKo": "-고 있다",
    "meaningZh": "正在…",
    "category": "語尾與表達",
    "attachRule": "動詞詞幹接 -고 있다，禮貌形式為 -고 있어요。",
    "explanation": "表示動作正在進行；部分動詞也可表示結果狀態。",
    "examples": [
      {
        "ko": "지금 공부하고 있어요.",
        "zh": "我現在正在讀書。"
      },
      {
        "ko": "친구를 기다리고 있어요.",
        "zh": "我正在等朋友。"
      }
    ]
  },
  {
    "id": "boda",
    "titleKo": "보다",
    "meaningZh": "比…",
    "category": "助詞",
    "attachRule": "直接接比較的基準名詞。",
    "explanation": "表示比較，可搭配 더（更）或 덜（較不）。",
    "examples": [
      {
        "ko": "오늘은 어제보다 추워요.",
        "zh": "今天比昨天冷。"
      },
      {
        "ko": "버스가 택시보다 싸요.",
        "zh": "公車比計程車便宜。"
      }
    ]
  }
]
